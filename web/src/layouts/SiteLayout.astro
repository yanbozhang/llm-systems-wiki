---
import {Search, ArrowUpRight, Github, Sun, Moon, Menu, House, Library, Route, Map, Layers, BookOpen, ExternalLink} from 'lucide-astro';
import Logo from '../components/Logo.astro';
import ModuleIcon from '../components/ModuleIcon.astro';
import {modules,topics} from '../lib/content';
import {sitePath,REPOSITORY} from '../lib/navigation';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?:string; description?:string; active?:string; section?:string; }
const {title='从公式到源码，系统学习大模型',description='45个主题、135个知识点。连接大模型公式、代码、结构图与源码的开放学习手册。',active='home',section='知识总览'}=Astro.props;
const nav=[{id:'home',label:'知识总览',en:'Overview',url:'/',icon:House},{id:'library',label:'探索知识',en:'Explore the library',url:'/library/',icon:Library},{id:'paths',label:'学习路径',en:'Learning paths',url:'/paths/',icon:Route},{id:'map',label:'能力地图',en:'Capability map',url:'/guides/map/',icon:Map}];
const canonical=new URL(Astro.url.pathname,'https://yanbozhang.github.io');
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} · LLM Systems Wiki</title><meta name="description" content={description}/>
  <meta name="theme-color" content="#f8f9f6"/><link rel="canonical" href={canonical}/>
  <meta property="og:image" content="https://yanbozhang.github.io/llm-systems-wiki/site-preview.png"/><meta name="twitter:card" content="summary_large_image"/>
  <meta property="og:title" content={`${title} · LLM Systems Wiki`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
  <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')}/>
  <script is:inline>try{const t=localStorage.getItem('llmwiki:theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;}catch{}</script>
</head>
<body>
<a class="skip-link" href="#main-content">跳到正文</a>
<div class="sidebar-backdrop" data-close-menu></div>
<aside class="sidebar" id="site-sidebar" aria-label="主导航">
  <a href={sitePath('/')} class="brand"><Logo/><span>LLM Systems<span class="brand-sub">W I K I</span></span></a>
  <div class="sidebar-edition"><span class="status-dot"></span><span data-zh="开放的大模型学习手册" data-en="An open field guide to AI">开放的大模型学习手册</span></div>
  <nav class="primary-nav">{nav.map(n=><a href={sitePath(n.url)} class:list={['nav-link',{active:active===n.id}]} aria-current={active===n.id?'page':undefined}><n.icon size={18} strokeWidth={1.7}/><span data-zh={n.label} data-en={n.en}>{n.label}</span>{active===n.id&&<span class="active-pip"/>}</a>)}</nav>
  <div class="nav-label" data-zh="知识模块" data-en="THE KNOWLEDGE STACK">知识模块</div>
  <nav class="module-nav">{modules.map(m=><a class:list={['nav-link module-link',{active:active===m.id}]} href={sitePath(`/modules/${m.id}/`)} aria-current={active===m.id?'page':undefined}><span class={`module-symbol ${m.color}`}><ModuleIcon id={m.id} size={17}/></span><span data-zh={m.title} data-en={m.english}>{m.title}</span><span class="nav-count">{topics.filter(t=>t.module===m.id).length}</span></a>)}</nav>
  <div class="nav-label" data-zh="继续深入" data-en="GO DEEPER">继续深入</div>
  <nav class="secondary-nav"><a class:list={['nav-link',{active:active==='frameworks'}]} href={sitePath('/guides/frameworks/')}><Layers size={18}/><span data-zh="Agent 方案导读" data-en="Agent frameworks">Agent 方案导读</span></a><a class:list={['nav-link',{active:active==='resources'}]} href={sitePath('/guides/resources/')}><BookOpen size={18}/><span data-zh="课程与资料" data-en="Courses & resources">课程与资料</span></a><a class="nav-link" href={sitePath('/sources/')}><ExternalLink size={18}/><span data-zh="来源索引" data-en="Source index">来源索引</span></a></nav>
  <a class="sidebar-footer" href={`${REPOSITORY}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noreferrer"><span class="contributor-symbol">+</span><span><strong data-zh="让知识一起生长" data-en="Build this library with us">让知识一起生长</strong><small data-zh="贡献一个问题、推导或反例" data-en="Contribute a note or an idea">贡献一个问题、推导或反例</small></span><ArrowUpRight size={16}/></a>
</aside>
<div class="workspace">
  <header class="topbar">
    <button class="icon-button mobile-menu" data-open-menu aria-label="打开导航" aria-controls="site-sidebar" aria-expanded="false"><Menu size={21}/></button>
    <div class="breadcrumb"><span class="breadcrumb-root" data-zh="知识库" data-en="Library">知识库</span><span>/</span><strong>{section}</strong></div>
    <div class="topbar-actions"><button class="search-trigger" data-open-search><Search size={16}/><span data-zh="搜索知识…" data-en="Search the library…">搜索知识…</span><kbd>⌘ K</kbd></button><button class="language-button" data-language-toggle aria-label="Switch language">EN</button><button class="icon-button theme-toggle" data-theme-toggle aria-label="切换颜色主题"><Sun class="sun-icon" size={18}/><Moon class="moon-icon" size={18}/></button><a class="github-button" href={REPOSITORY} target="_blank" rel="noreferrer" aria-label="GitHub repository"><Github size={18}/><span>Star</span><ArrowUpRight size={14}/></a></div>
  </header>
  <main id="main-content" tabindex="-1"><slot/></main>
  <footer class="page-footer"><span>LLM Systems Wiki<span class="footer-dot">·</span><span data-zh="从公式到源码" data-en="From equations to source code">从公式到源码</span></span><div><a href={`${REPOSITORY}/blob/main/LICENSE`}>MIT</a><a href={`${REPOSITORY}/blob/main/CONTRIBUTING.md`} data-zh="参与贡献" data-en="Contribute">参与贡献</a><a href={REPOSITORY}>GitHub <ArrowUpRight size={12}/></a></div></footer>
</div>
<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title">
  <div class="search-dialog-top"><Search size={22}/><label class="sr-only" for="global-search" id="search-title">搜索知识</label><input id="global-search" placeholder="搜索主题、公式、工具…" data-placeholder-zh="搜索主题、公式、工具…" data-placeholder-en="Search topics, equations, tools…" autocomplete="off"/><button class="escape-key" data-close-search aria-label="关闭搜索">Esc</button></div>
  <div class="search-hint" data-zh="试试 Transformer、RAG、Codex 或 KV 缓存" data-en="Try Transformer, RAG, Codex, or KV cache">试试 Transformer、RAG、Codex 或 KV 缓存</div>
  <div id="search-results" class="search-results" aria-live="polite"></div>
  <div class="search-dialog-footer"><span data-zh="搜索整个知识库" data-en="Search across the whole library">搜索整个知识库</span><a href={sitePath('/library/')} data-zh="浏览全部主题 →" data-en="Browse all topics →">浏览全部主题 →</a></div>
</dialog>
<div class="toast" role="status" aria-live="polite" id="toast"></div>
<script>import '../client/site';</script>
</body>
</html>
