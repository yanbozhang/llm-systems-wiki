---
import {ArrowRight,ArrowUpRight,GitBranch,BookOpen,Route} from 'lucide-astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import SystemVisual from '../components/SystemVisual.astro';
import ModuleIcon from '../components/ModuleIcon.astro';
import TopicCard from '../components/TopicCard.astro';
import {modules,topics,units,paths} from '../lib/content';
import {sitePath,REPOSITORY} from '../lib/navigation';
const selected=['transformer','kv-cache','codex-cli','mobile-agent','rag','benchmark-metrics'].map(id=>topics.find(t=>t.id===id)!);
---
<SiteLayout>
<div class="home content-wrap">
  <section class="hero">
    <div class="hero-copy"><div class="eyebrow"><span class="eyebrow-line"></span><span data-zh="为好奇心，构建一张知识地图" data-en="A FIELD GUIDE FOR CURIOUS BUILDERS">为好奇心，构建一张知识地图</span></div>
      <h1 class="hero-title"><span data-zh="从一个公式，" data-en="Understand the ideas.">从一个公式，</span><br/><em data-zh="走进整个系统。" data-en="Build the systems.">走进整个系统。</em></h1>
      <p class="hero-description" data-zh="把大模型的论文、公式与源码，连接成真正理解的路径。从 Transformer 到 Agent，每一份好奇，都有一个深入的入口。" data-en="Connect the papers, equations, and source code behind large language models. From Transformers to agents, find a path from curiosity to understanding.">把大模型的论文、公式与源码，连接成真正理解的路径。从 Transformer 到 Agent，每一份好奇，都有一个深入的入口。</p>
      <div class="hero-actions"><a class="button primary" href={sitePath('/library/')}><span data-zh="开始探索" data-en="Explore the library">开始探索</span><ArrowRight size={17}/></a><a class="button text-button" href={sitePath('/paths/')}><Route size={17}/><span data-zh="找到你的学习路径" data-en="Find your learning path">找到你的学习路径</span></a></div>
      <div class="hero-note"><span class="tiny-stack"><i></i><i></i><i></i></span><span data-zh="开源 · 可查证 · 可实践" data-en="Open source. Traceable. Hands-on.">开源 · 可查证 · 可实践</span></div>
    </div><SystemVisual/>
  </section>
  <section class="stats-strip" aria-label="知识库概况"><div><strong>{modules.length}<span>/</span></strong><span data-zh="知识模块" data-en="Knowledge areas">知识模块</span></div><div><strong>{topics.length}<span>/</span></strong><span data-zh="深入主题" data-en="In-depth topics">深入主题</span></div><div><strong>{units.length}<span>/</span></strong><span data-zh="可探索知识点" data-en="Knowledge units">可探索知识点</span></div><div><strong>{paths.length}<span>/</span></strong><span data-zh="系统学习路径" data-en="Learning paths">系统学习路径</span></div><p data-zh="每个知识点，连接\n公式、代码与结构图。" data-en="Every idea connects\nequations, code, and diagrams.">每个知识点，连接<br/>公式、代码与结构图。</p></section>
  <section class="home-section"><div class="section-heading"><div><span class="section-kicker">01 / THE KNOWLEDGE STACK</span><h2 data-zh="一张地图，七个入口。" data-en="One map. Seven ways in.">一张地图，七个入口。</h2></div><a class="inline-link" href={sitePath('/guides/map/')}><span data-zh="查看能力地图" data-en="View capability map">查看能力地图</span><ArrowUpRight size={16}/></a></div>
    <div class="module-grid">{modules.map(m=>{const count=topics.filter(t=>t.module===m.id).length;const unitCount=units.filter(u=>topics.find(t=>t.id===u.topic)?.module===m.id).length;return <a href={sitePath(`/modules/${m.id}/`)} class:list={['module-card',{'module-card-wide':m.id==='benchmark'}]}><div class="module-card-head"><span class={`module-icon ${m.color}`}><ModuleIcon id={m.id} size={24}/></span><span class="module-number">{m.number}</span></div><div class="module-card-body"><div class="module-name-line"><h3 data-zh={m.title} data-en={m.english}>{m.title}</h3><span class="module-english">{m.english}</span></div><p>{m.subtitle}</p></div><div class="module-card-foot"><span data-zh={`${count} 个主题 · ${unitCount} 个知识点`} data-en={`${count} topics · ${unitCount} units`}>{count} 个主题 · {unitCount} 个知识点</span><ArrowUpRight size={19}/></div></a>})}</div>
  </section>
  <section class="home-section"><div class="section-heading"><div><span class="section-kicker">02 / FOLLOW YOUR CURIOSITY</span><h2 data-zh="从一个具体问题开始。" data-en="Start with a real question.">从一个具体问题开始。</h2></div><a class="inline-link" href={sitePath('/library/')}><span data-zh="浏览全部主题" data-en="Browse all topics">浏览全部主题</span><ArrowRight size={16}/></a></div><div class="topic-grid">{selected.map(t=><TopicCard topic={t}/>)}</div></section>
  <section class="learning-banner"><div class="learning-banner-icon"><GitBranch size={35} strokeWidth={1.3}/></div><div><span class="section-kicker" data-zh="让零散知识，成为系统理解" data-en="FROM SCATTERED NOTES TO CONNECTED IDEAS">让零散知识，成为系统理解</span><h2 data-zh="不止读过，更能解释与实现。" data-en="Go beyond reading. Explain and build.">不止读过，更能解释与实现。</h2><p data-zh="六条循序渐进的学习路径，把每次阅读变成一次推导、一个反例，或一份可复查的实践。" data-en="Six guided paths turn each reading into a derivation, a counterexample, or a reproducible practice.">六条循序渐进的学习路径，把每次阅读变成一次推导、一个反例，或一份可复查的实践。</p></div><a class="button secondary" href={sitePath('/paths/')}><span data-zh="选择学习路径" data-en="Choose your path">选择学习路径</span><ArrowRight size={17}/></a></section>
  <div class="open-note"><BookOpen size={17}/><p><span data-zh="知识应当开放，理解值得分享。" data-en="Knowledge stays open. Understanding is worth sharing.">知识应当开放，理解值得分享。</span> <a href={`${REPOSITORY}/blob/main/CONTRIBUTING.md`} data-zh="一起完善这本手册 ↗" data-en="Help shape this field guide ↗">一起完善这本手册 ↗</a></p></div>
</div>
</SiteLayout>
