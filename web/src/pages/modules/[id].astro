---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Catalog from '../../components/Catalog.astro';
import ModuleIcon from '../../components/ModuleIcon.astro';
import {modules,topics,capabilities,frontiers,readModuleOverview,routes} from '../../lib/content';
import {renderMarkdown} from '../../lib/markdown';
import {sitePath} from '../../lib/navigation';
export function getStaticPaths(){return modules.map(m=>({params:{id:m.id},props:{module:m}}));}
const {module}=Astro.props;const items=topics.filter(t=>t.module===module.id);const goals=capabilities.filter(c=>c.module===module.id);
const overview=await renderMarkdown(readModuleOverview(module),module.page,routes);
const frontier=frontiers.find(entry=>entry.module===module.id);
---
<SiteLayout title={module.title} section={module.title} active={module.id}>
  <div class="content-wrap inner-page">
    <header class="page-intro">
      <span class={`module-icon ${module.color}`}><ModuleIcon id={module.id} size={25}/></span>
      <span class="section-kicker">{module.number} / {module.english.toUpperCase()}</span>
      <h1 data-zh={module.title} data-en={module.english}>{module.title}</h1>
      <p>{module.subtitle}。先理解系统怎样运转，再进入每个主题的推导与实现。</p>
      <nav class="module-reading-order" aria-label="模块阅读顺序">
        <a href="#module-system" data-zh="01 系统架构与说明" data-en="01 System architecture">01 系统架构与说明</a>
        <a href="#module-topics" data-zh="02 主题介绍" data-en="02 Explore topics">02 主题介绍</a>
        <a href="#module-capabilities" data-zh="03 能力与实践" data-en="03 Practice and outcomes">03 能力与实践</a>
      </nav>
    </header>
    <section id="module-system" class="module-system" aria-label={`${module.title}系统架构与说明`}>
      <article class="markdown" set:html={overview.html}/>
    </section>
    <section id="module-topics" class="module-topic-section">
      <div class="section-heading"><div><span class="section-kicker">TOPIC MAP</span><h2 data-zh="从系统走进主题" data-en="Explore the system in detail">从系统走进主题</h2></div></div>
      <p class="module-topic-hint" data-zh="每个主题先给出整体介绍和阅读路线，再展开公式、代码、结构图及练习。" data-en="Each topic begins with an overview and learning route, followed by equations, code, diagrams and exercises.">每个主题先给出整体介绍和阅读路线，再展开公式、代码、结构图及练习。</p>
      <Catalog items={items} selectedModule={module.id} showModules={false}/>
    </section>
    <div id="module-capabilities" class="module-goals"><strong data-zh="在这个模块，你将能够" data-en="What you can learn here">在这个模块，你将能够</strong><div>{goals.map(goal=><span>{goal.outcome}</span>)}</div><a href={sitePath('/guides/map/')} data-zh="查看能力与实践成果 →" data-en="See capabilities and deliverables →">查看能力与实践成果 →</a></div>
    {frontier&&<p class="module-update"><a href={sitePath(`/research/${frontier.id}/`)} data-zh="阅读这个模块的2026研究进展 →" data-en="Explore this module’s 2026 research →">阅读这个模块的2026研究进展 →</a></p>}
  </div>
</SiteLayout>
<script>import '../../client/reader';</script>
