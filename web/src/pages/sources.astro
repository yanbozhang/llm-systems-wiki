---
import {ArrowUpRight} from 'lucide-astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {sources} from '../lib/content';
---
<SiteLayout title="来源索引" active="sources" section="来源索引"><div class="content-wrap inner-page"><header class="page-intro"><div class="eyebrow"><span class="eyebrow-line"></span><span>TRACE THE IDEAS</span></div><h1 data-zh="每一份理解，都有来处。" data-en="Follow every idea to its source.">每一份理解，都有来处。</h1><p>论文、课程、官方文档与固定版本的源码，构成了这本手册的依据。{sources.length} 条记录保留实际读取范围；同一来源的不同文件或版本分别记录。</p></header><label class="catalog-search source-filter"><span class="sr-only">搜索来源</span><input type="search" data-source-search placeholder="搜索来源名称、类型或读取范围…" data-placeholder-zh="搜索来源名称、类型或读取范围…" data-placeholder-en="Filter sources by title or scope…"/></label><div class="catalog-meta"><span><strong data-source-count>{sources.length}</strong> <span data-zh="条来源记录" data-en="source records">条来源记录</span></span><span data-zh="保留原作权利与许可" data-en="Original rights and licenses apply">保留原作权利与许可</span></div><div class="sources-list">{sources.map((s,i)=><a class="source-row" href={s.url} target="_blank" rel="noreferrer" data-source-row><span>{String(i+1).padStart(3,'0')}</span><div><h2>{s.title}</h2><code>{s.id} · {s.kind||'reference'}</code><p>{s.reading_scope}</p></div><ArrowUpRight size={16}/></a>)}</div><div class="empty-state" data-source-empty hidden data-zh="没有找到匹配的来源，请换个关键词。" data-en="No matching sources. Try another keyword.">没有找到匹配的来源，请换个关键词。</div></div></SiteLayout>
