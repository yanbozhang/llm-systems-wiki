---
import SiteLayout from '../layouts/SiteLayout.astro';
import Catalog from '../components/Catalog.astro';
import {topics} from '../lib/content';
const description=`从你想弄懂的问题出发。${topics.length}个深入主题，先理解整体，再逐步展开公式、代码与结构图。`;
---
<SiteLayout title="探索知识" section="探索知识" active="library"><div class="content-wrap inner-page"><header class="page-intro"><div class="eyebrow"><span class="eyebrow-line"></span><span>THE LIBRARY</span></div><h1 data-zh="把好奇，变成理解。" data-en="Turn curiosity into understanding.">把好奇，变成理解。</h1><p data-zh={description} data-en={`Explore ${topics.length} topics, from the big picture to equations, code and diagrams.`}>{description}</p></header><Catalog items={topics}/></div></SiteLayout>
